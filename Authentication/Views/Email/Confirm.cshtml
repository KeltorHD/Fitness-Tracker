@model FitLife.Authentication.Controllers.EmailConfirmPage
<div class="card-heading"><h1 id="page-title" data-localize>Подтвердите электронную почту</h1></div>
@if (Model.CanConfirm)
{
  <p class="privacy-note" data-localize>Нажмите кнопку, если вы создавали аккаунт FitLife с этим адресом.</p>
  <form class="credential-form" method="post" action="/email/confirm" asp-antiforgery="true">
    <input type="hidden" name="userId" value="@Model.UserId" />
    <input type="hidden" name="code" value="@Model.Code" />
    <button class="button button-primary" type="submit" data-localize>Подтвердить адрес</button>
  </form>
}
else
{
  <p class="form-alert" role="alert" data-localize>Ссылка недействительна или срок её действия истёк. Запросите новое письмо.</p>
  <p class="privacy-note" data-localize>Если с регистрации прошло 2 часа, создайте аккаунт заново.</p>
  <a class="text-link" href="/register" data-localize>Создать аккаунт</a>
  <a class="text-link" href="/email/verify" data-localize>Отправить письмо повторно</a>
}
