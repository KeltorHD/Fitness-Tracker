SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
CODE_SIGN_STYLE = Automatic
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
// Legacy keys keep existing Local.xcconfig files and installed app data working.
FITSESSION_BUNDLE_ID = com.example.fitsession
FITNESS_TRACKER_BUNDLE_ID = $(FITSESSION_BUNDLE_ID)
FITSESSION_APP_GROUP = group.$(FITNESS_TRACKER_BUNDLE_ID)
FITNESS_TRACKER_APP_GROUP = $(FITSESSION_APP_GROUP)
FITSESSION_CLOUD_CONTAINER = iCloud.$(FITNESS_TRACKER_BUNDLE_ID)
FITNESS_TRACKER_CLOUD_CONTAINER = $(FITSESSION_CLOUD_CONTAINER)
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_USER_SCRIPT_SANDBOXING = YES
#include? "Local.xcconfig"
