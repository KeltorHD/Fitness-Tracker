<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ru</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleDisplayName</key>
	<string>FitLife</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSAlarmKitUsageDescription</key>
	<string>Устанавливать будильники сна с обязательным сигналом к выбранному времени.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Читать сон, пульс и другие показатели из «Здоровья» для дневника и статистики; по вашему запросу — данные тренировки для приёма измерений Apple Watch или AirPods Pro 3.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Включать системную тренировку для получения пульса Apple Watch или AirPods Pro 3 по вашему запросу. Завершённая тренировка сохраняется в «Здоровье» только при отдельном экспорте.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>bluetooth-central</string>
	</array>
	<key>FitLifeAppGroup</key>
	<string>$(FITLIFE_APP_GROUP)</string>
	<key>FitLifeAuthenticationURL</key>
	<string>$(FITLIFE_AUTH_URL)</string>
	<key>FitLifeBackendURL</key>
	<string>$(FITLIFE_BACKEND_URL)</string>
	<key>FitLifeAuthenticationCallbackMode</key>
	<string>$(FITLIFE_AUTH_CALLBACK_MODE)</string>
	<key>FitLifeAuthenticationCallbackScheme</key>
	<string>$(FITLIFE_AUTH_CALLBACK_SCHEME)</string>
	<key>FitLifeCloudContainer</key>
	<string>$(FITLIFE_CLOUD_CONTAINER)</string>
	<key>FitLifeCloudSyncAvailable</key>
	<string>$(FITLIFE_CLOUD_SYNC_AVAILABLE)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>FitLife</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fitlife</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>FitLife.Authentication</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(FITLIFE_AUTH_CALLBACK_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.fitlife.archive</string>
			<key>UTTypeDescription</key>
			<string>Архив FitLife</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>fitlife</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.fitlife+json</string>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Архив FitLife</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.fitlife.archive</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>JSON FitLife</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.json</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Workout CSV</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.comma-separated-values-text</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ru</string>
		<string>en</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Подключать Bluetooth-пульсометр, например Mi Band или HUAWEI WATCH, и записывать пульс во время тренировки.</string>
	<key>NSCameraUsageDescription</key>
	<string>Сканировать штрихкоды упаковок, чтобы найти продукт и добавить его в дневник питания.</string>
</dict>
</plist>
