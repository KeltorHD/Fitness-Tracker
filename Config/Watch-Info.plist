<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ru</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleDisplayName</key>
	<string>FitLife</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>WKBackgroundModes</key>
	<array><string>alarm</string><string>workout-processing</string></array>
	<key>NSHealthShareUsageDescription</key>
	<string>Получать пульс с Apple Watch во время тренировки и передавать измерения на ваш iPhone.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Включать системный сеанс тренировки для измерения пульса. Сохранение тренировки в «Здоровье» выполняется отдельно на iPhone.</string>
	<key>NSMotionUsageDescription</key>
	<string>Оценивать движения запястья в выбранном окне умного будильника.</string>
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>$(FITLIFE_BUNDLE_ID)</string>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<true/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ru</string>
		<string>en</string>
	</array>
</dict>
</plist>
