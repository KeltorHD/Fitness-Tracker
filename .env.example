# Public HTTPS is provided by your existing Nginx on the Docker host.
AUTH_DOMAIN=auth.example.com
API_DOMAIN=api.example.com
# App ID Prefix.Bundle ID from Apple; leave empty until the app is registered.
IOS_APP_IDENTIFIER=

# Loopback-only upstreams; match proxy_pass ports in Config/Server/nginx.conf.example.
AUTH_HTTP_PORT=5080
API_HTTP_PORT=5081

# Run python3 scripts/setup-server-network.py after editing domains/ports.
# Docker chooses the subnet; the script fills subnet/gateway and generates Nginx config.
SERVER_NETWORK_NAME=fitness-tracker-server
SERVER_NETWORK_SUBNET=
SERVER_NETWORK_GATEWAY=

# Persistent folders, relative to compose.yml or absolute paths to another disk.
AUTH_DB_DATA_PATH=./.local/auth-db
BACKEND_DB_DATA_PATH=./.local/backend-db
AUTH_KEYS_PATH=./.local/auth-keys
AUTH_CERTIFICATES_PATH=./.local/certificates
BACKEND_KEYS_PATH=./.local/backend-keys
BACKEND_CERTIFICATES_PATH=./.local/backend-certificates
# Override only when connecting to an existing database with different identifiers.
BACKEND_DB_NAME=fitnesstracker_backend
BACKEND_DB_USER=fitnesstracker_backend

# Generated by scripts/setup-server.sh. Never commit .env or private keys.
AUTH_DB_PASSWORD=
BACKEND_DB_PASSWORD=
BACKEND_SERVICE_KEY=
# Confidential client secret for Backend -> Auth introspection; never send to iOS.
BACKEND_INTROSPECTION_SECRET=
# Password for Auth and separate Backend PFX files, separate from Nginx TLS.
CERTIFICATE_PASSWORD=

GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_ENABLED=false
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
