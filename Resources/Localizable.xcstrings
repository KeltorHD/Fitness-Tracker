        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для частых измерений запустите приложение «Тренировка» на Apple Watch. FitnessTracker показывает измерения, поступившие в Apple «Здоровье»; передача может происходить с задержкой."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
