    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FitSession запрашивает доступ к тренировкам только для функций «Здоровья». Чтение данных сейчас не используется."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FitSession requests workout access only for Health features. Reading health data is not currently used."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять завершённые силовые тренировки в «Здоровье» по вашему запросу."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save completed strength workouts to Health when you request it."
          }
        }
      }
    }
  },
  "version": "1.0"
