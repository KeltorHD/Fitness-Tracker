{
  "sourceLanguage": "ru",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FitnessTracker"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FitnessTracker"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключать Bluetooth-пульсометр, например Mi Band или HUAWEI WATCH, и записывать пульс во время тренировки."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a Bluetooth heart rate monitor, such as a Mi Band or HUAWEI WATCH, and record heart rate during your workout."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать шаги, активную энергию, сон и пульс из «Здоровья» и загружать измерения пульса для вашей тренировки по вашему запросу."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show steps, active energy, sleep and heart rate from Health, and load heart rate measurements for your workout when you request it."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять завершённые силовые тренировки в «Здоровье» по вашему запросу."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save completed strength workouts to Health when you request it."
          }
        }
      }
    }
  },
  "version": "1.0"
}
