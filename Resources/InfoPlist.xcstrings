{
  "sourceLanguage": "ru",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FitLife"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FitLife"
          }
        }
      }
    },
    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливать будильники сна с обязательным сигналом к выбранному времени."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedule sleep alarms with a fallback alert at the selected time."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключать Bluetooth-пульсометр, например Mi Band или HUAWEI WATCH, и записывать пульс во время тренировки."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a Bluetooth heart rate monitor, such as a Mi Band or HUAWEI WATCH, and record heart rate during your workout."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканировать штрихкоды упаковок, чтобы найти продукт и добавить его в дневник питания."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan barcodes on food packaging to find products and add them to your food diary."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читать сон, шаги, вес, долю жира, пульс, кислород, активную энергию и расстояние для дневника и статистики. При включённой вами синхронизации эти данные передаются в ваш аккаунт FitLife. По вашему запросу — читать данные тренировки для получения пульса Apple Watch или AirPods Pro 3."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read sleep, steps, weight, body fat, heart rate, blood oxygen, active energy and distance for your diary and statistics. When you enable syncing, this data is sent to your FitLife account. When requested, read workout data to receive Apple Watch or AirPods Pro 3 heart rate."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включать системную тренировку для получения пульса Apple Watch или AirPods Pro 3 по вашему запросу. Завершённая тренировка сохраняется в «Здоровье» только при отдельном экспорте."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a system workout to receive Apple Watch or AirPods Pro 3 heart rate when you request it. The completed workout is saved to Health only through a separate export."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценивать движения запястья в выбранном окне умного будильника."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate wrist movement during your chosen smart alarm window."
          }
        }
      }
    }
  },
  "version": "1.0"
}
